{
  "name": "swarmbid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Deterministic multi-robot auction simulation monorepo",
  "scripts": {
    "test": "pnpm -r run test",
    "lint": "eslint --no-error-on-unmatched-pattern \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/test/**/*.{ts,tsx}\"",
    "build": "pnpm sync:wasm && pnpm -r run build",
    "dev": "pnpm sync:wasm && pnpm --filter @swarmbid/web dev",
    "sync:wasm": "mkdir -p packages/web/public && cp node_modules/.pnpm/highs@*/node_modules/highs/build/highs.wasm packages/web/public/highs.wasm",
    "bench": "tsx scripts/bench.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.6.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@swarmbid/baseline": "workspace:*",
    "@swarmbid/sim": "workspace:*",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
